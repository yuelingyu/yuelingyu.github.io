@article{yue_strain_2022,
	title = {热塑性材料双轴引伸计应变测量在热机械测试中的应用：聚碳酸酯温度和物理老化效应表征案例},
	volume = {62},
	issn = {0014-4851, 1741-2765},
	shorttitle = {热塑性材料双轴引伸计应变测量在热机械测试中的应用},
	url = {https://link.springer.com/10.1007/s11340-022-00890-2},
	doi = {10.1007/s11340-022-00890-2},
	abstract = {背景：表征材料在高温下的机械行为对于设计和开发在复杂工作条件下使用的聚合物系统至关重要。常用的动态机械分析(DMA)不适用于材料三维性能的研究。机械测试系统与环境腔体和引伸计测量的结合更适合此目的。然而，双轴引伸计在高温下测量热塑性试样的应变时会出现误差。
目标：本技术说明分析了引伸计测量误差的来源，并提出了一种稳健而直接的高温三维机械测试实验程序。
方法：以聚碳酸酯在120°C下的两个温度和物理老化效应表征实验作为案例研究。分析并校正了轴向和横向测量中的热漂移和渗透漂移。
结果：两次测试的校正实验结果几乎相同，证明了所提出程序的可重现性。此外，使用校正应变计算的体积相关应变随时间单调增加，符合热力学原理，从而证明了实验结果的可靠性。
结论：本工作描述的方法可作为指导双轴引伸计三维热机械测试的协议。},
	language = {zh},
	number = {9},
	urldate = {2023-03-08},
	journal = {实验力学},
	author = {岳, 凌宇 and Jalbert, J. and Heuzey, M.-C. and Lévesque, M.},
	month = nov,
	year = {2022},
	pages = {1691--1699},
	bibtex_show = {true}
}

@article{moeini_surrogate_2023,
	title = {晶格足部矫形器的代理优化},
	volume = {155},
	issn = {00104825},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0010482522010848},
	doi = {10.1016/j.compbiomed.2022.106376},
	abstract = {背景：增材制造能够打印患者特定的足部矫形器(FOs)。在具有晶格结构的FOs中，细胞尺寸的变化提供了局部可变刚度，以满足每个患者的治疗需求。然而，在优化问题中，使用收敛3D单元对晶格FOs进行显式有限元(FE)仿真在计算上是禁止的。本文提出了一个框架，以有效优化蜂窝晶格FO的细胞尺寸，用于扁平足条件。
方法：我们基于壳单元构建了一个代理，其机械性能通过数值均匀化技术计算。该模型受到扁平足的静态压力分布，并为给定的蜂窝FO几何参数集预测位移场。此FE仿真被视为黑盒，采用无导数优化求解器。成本函数基于模型预测位移与治疗目标位移之间的差异定义。
结果：使用均匀化模型作为代理显著加速了晶格FO的刚度优化。均匀化模型能够比显式模型快78倍地预测位移场。当优化问题需要2000次评估时，使用均匀化模型而不是显式模型，计算时间从34天减少到10小时。此外，在均匀化模型中，不需要在优化的每次迭代中重新创建和重新网格化鞋垫的几何形状。只需要更新有效属性。
结论：所提出的均匀化模型可以在优化框架内作为代理，以计算有效的方式定制蜂窝晶格FO的细胞尺寸。},
	language = {zh},
	urldate = {2023-03-08},
	journal = {生物学和医学中的计算机},
	author = {Moeini, Mohammadreza and 岳, 凌宇 and Begon, Mickael and Lévesque, Martin},
	month = mar,
	year = {2023},
	pages = {106376},
	bibtex_show = {true}
}

@article{yue_multiscale_2023,
	title = {热塑性复合材料的多尺度模拟：从聚合物链到宏观性能},
	volume = {27},
	issn = {1385-2000, 1573-2738},
	shorttitle = {热塑性复合材料的多尺度模拟},
	url = {https://link.springer.com/10.1007/s11043-023-09605-x},
	doi = {10.1007/s11043-023-09605-x},
	abstract = {本文回顾了热塑性复合材料多尺度建模的最新进展，从分子级聚合物链行为到宏观机械性能。我们讨论了各种建模方法，包括分子动力学、粗粒化模型和连续介质力学方法，以及它们在理解和预测热塑性复合材料行为中的应用。特别关注了界面性能、时效效应和温度依赖性行为的建模挑战。},
	language = {zh},
	number = {4},
	urldate = {2025-02-26},
	journal = {时变材料力学},
	author = {岳, 凌宇 and Heuzey, Marie-Claude and Jalbert, Jonathan and Lévesque, Martin},
	month = dec,
	year = {2023},
	pages = {949--971},
	bibtex_show = {true}
}

@article{zhang_cfrtp_2024,
	title = {连续纤维增强热塑性复合材料成型工艺仿真的研究进展},
	volume = {52},
	issn = {1005-5770},
	url = {https://kns.cnki.net/kcms2/article/abstract?v=YHRUfPYi6NObPLMWjJhlVQjBTFSK4bFAHmAnnmqOf3WAZczKu6wRRv-VSkLxphAJHSq5g58x1iFan-8A8uesORaV6Zt5OXRGvkL_AZ2vNO7rNUio8_F7yK2fI2JWo6sFZFWnzXzXHpZjkSTln29VLgJ6s-eB7Vij_vA9gbOkPLn3ZVD3G_o8Sw5BMcrevZan&uniplatform=NZKPT&language=CHS},
	abstract = {本文简要介绍了连续纤维增强热塑性复合材料(CFRTP)模压成型、拉挤成型、自动铺放成型、增材制造和连续层压-冲压成型的原理、适用场景及优缺点。综述了不同工艺成型过程中的热传递、树脂挤压流动、层间结合、孔隙缺陷形成和残余应力变形的仿真研究进展，指出开发精确描述材料行为的模型以及高效求解算法，实现成型工艺的高精高效仿真，是研究CFRTP成型工艺参数与最终制品性能之间相互作用的关键。最后，总结了CFRTP成型工艺仿真研究目前存在的问题，并对未来的发展与应用进行了展望。},
	language = {zh},
	number = {12},
	journal = {塑料工业},
	author = {张, 金峰 and 岳, 凌宇 and 祝, 颖丹 and 刘, 东 and 陈, 明达 and 张, 毅 and 韩, 宇},
	year = {2024},
	keywords = {成型工艺, 热塑性复合材料, 连续纤维, 工艺仿真, 挤压流动},
	pages = {8--16},
	bibtex_show = {true}
}
